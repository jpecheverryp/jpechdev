package layout

import "jpech.dev/views/partial"

templ Base() {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<title>Juan P Echeverry - Software Developer</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.cyan.min.css"/>
			<script src="https://kit.fontawesome.com/18a9386424.js" crossorigin="anonymous"></script>
			<link rel="icon" type="image/x-icon" href="/static/images/favicon.ico"/>
		</head>
		<body class="container" style="max-width: 800px; padding: 0 20px;">
			@partial.Nav()
			<main>
				{ children... }
			</main>
			@partial.Footer()
		</body>
	</html>
}
